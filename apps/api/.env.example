# Rocky API — environment template. Copy to .env and fill in real values.
#   cp .env.example .env
# Real .env is gitignored; this template is tracked. Never commit secrets here.

# --- App ---
APP_NAME=Rocky API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database (app/db/session.py) ---
# Either set DATABASE_URL (full async SQLAlchemy URL, takes precedence)...
DATABASE_URL=
# ...or provide the POSTGRES_* parts (used only if DATABASE_URL is unset).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Connection pool tuning (optional; defaults shown).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- JWT / auth (app/core/security.py) ---
# SECRET_KEY is REQUIRED — token signing raises if unset.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Session / refresh-token policy (app/core/settings.py) ---
# Lifetimes in integer days (optional; defaults apply).
SESSION_TTL_DAYS=30
REFRESH_TOKEN_TTL_DAYS=30
# Server-side pepper for refresh-token hashing. REQUIRED — no fallback.
REFRESH_TOKEN_PEPPER=

# --- External services (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_TIMEOUT_SECONDS=4
OPENAI_TTS_API_KEY=
OPENAI_TTS_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_TTS_SPEED=0.95
LOCAL_TTS_ENABLED=true
LOCAL_TTS_PROVIDER=kokoro
LOCAL_TTS_VOICE=am_adam
LOCAL_TTS_SPEED=0.95

# --- Test harness (tests/test_migration_parity.py) ---
# PostgreSQL instance used by the migration/metadata parity guard. The role
# must have CREATE DATABASE privileges: the guard creates a throwaway
# rocky_parity_<uuid> database, runs the Alembic chain onto it, compares the
# result against Base.metadata, then drops it. Point the path at a maintenance
# database (usually /postgres); the scratch DB name is substituted at runtime.
# Only needed to run:  pytest -m parity
TEST_DATABASE_URL=
