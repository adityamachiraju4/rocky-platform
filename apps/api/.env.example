# Rocky API — environment template. Copy to .env and fill in real values.
#   cp .env.example .env
# Real .env is gitignored; this template is tracked. Never commit secrets here.

# --- App ---
APP_NAME=Rocky API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated browser/native origins allowed to call private APIs.
# Add the production web/PWA origin here once that frontend hosting domain is
# chosen. Keep Capacitor's https://localhost origin for native builds.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://localhost,https://rocky-web-preview.vercel.app

# --- Database (app/db/session.py) ---
# Either set DATABASE_URL (full async SQLAlchemy URL, takes precedence)...
DATABASE_URL=
# ...or provide the POSTGRES_* parts (used only if DATABASE_URL is unset).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Connection pool tuning (optional; defaults shown).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- JWT / auth (app/core/security.py) ---
# SECRET_KEY is REQUIRED — token signing raises if unset.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Session / refresh-token policy (app/core/settings.py) ---
# Lifetimes in integer days (optional; defaults apply).
SESSION_TTL_DAYS=30
REFRESH_TOKEN_TTL_DAYS=30
# Server-side pepper for refresh-token hashing. REQUIRED — no fallback.
REFRESH_TOKEN_PEPPER=

# --- Email verification / password recovery ---
# PUBLIC_APP_URL is the authenticated Rocky web app, not the marketing site.
PUBLIC_APP_URL=http://localhost:5173
# Configure a sender that is verified with the selected email provider.
EMAIL_FROM=
RESEND_API_KEY=
# Separate server-side pepper for hashing single-use auth action tokens.
AUTH_ACTION_TOKEN_PEPPER=
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60

# --- General assistant (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_TIMEOUT_SECONDS=4

# --- Speech synthesis (optional official OpenAI fallback) ---
OPENAI_TTS_API_KEY=
OPENAI_TTS_BASE_URL=https://api.openai.com/v1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_TTS_SPEED=0.95

# --- Speech transcription ---
TRANSCRIPTION_PROVIDER=local
# Release baseline. Set to "auto" only to experiment with multilingual
# detection; the production/default path explicitly decodes English.
TRANSCRIPTION_LANGUAGE=en
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_COMPUTE_TYPE=auto
LOCAL_WHISPER_WARMUP=true
OPENAI_TRANSCRIPTION_API_KEY=
OPENAI_TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# --- Live intelligence (optional provider keys) ---
# Weather and time work without keys. Do not expose these keys to the frontend.
LIVE_TIMEOUT_SECONDS=3
NEWS_API_KEY=
FINNHUB_API_KEY=
TAVILY_API_KEY=
GEOAPIFY_API_KEY=
THESPORTSDB_API_KEY=123

# --- Local speech synthesis ---
LOCAL_TTS_ENABLED=true
LOCAL_TTS_PROVIDER=kokoro
LOCAL_TTS_VOICE=am_adam
LOCAL_TTS_SPEED=0.95
LOCAL_TTS_WARMUP=true

# --- Test harness (tests/test_migration_parity.py) ---
# PostgreSQL instance used by the migration/metadata parity guard. The role
# must have CREATE DATABASE privileges: the guard creates a throwaway
# rocky_parity_<uuid> database, runs the Alembic chain onto it, compares the
# result against Base.metadata, then drops it. Point the path at a maintenance
# database (usually /postgres); the scratch DB name is substituted at runtime.
# Only needed to run:  pytest -m parity
TEST_DATABASE_URL=
