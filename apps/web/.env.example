# Rocky web frontend environment template. Copy to .env.local for local overrides.
# Never commit real secrets; Vite variables are bundled into frontend assets.

# Optional for browser dev. When unset, local dev uses /api and the Vite proxy.
# VITE_API_BASE_URL=http://localhost:8000

# Android emulator dev:
# VITE_API_BASE_URL=https://10.0.2.2:8000

# Production web/PWA and production native default to this Railway API when unset
# in production/native-release builds. Set explicitly in deployment config when
# you want the environment to be self-documenting.
# VITE_API_BASE_URL=https://rocky-platform-production.up.railway.app
